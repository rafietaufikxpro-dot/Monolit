# Host unit tests (PC): make -f Makefile.host test
.PHONY: test
test:
	g++ -std=c++17 -O1 -Wall -Wextra -o /tmp/monolit_test test/test_core.cpp source/hash.cpp source/sav.cpp source/pk.cpp source/bank.cpp source/tables.cpp
	/tmp/monolit_test
	# conversion tests (conv_data.cpp is generated by tools/gen_convert_tables.py)
	g++ -std=c++17 -O1 -Wall -Wextra -o /tmp/monolit_conv_test test/test_convert.cpp source/convert.cpp source/conv_data.cpp source/sidedata.cpp source/hash.cpp source/pk.cpp source/tables.cpp
	/tmp/monolit_conv_test
